<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<!-- CU2 · Reservar y confirmar una entrada. Sin fx:controller: App asigna PantallaReservaController. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      styleClass="pantalla" spacing="14">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>
    <Label text="Reservar una entrada" styleClass="titulo"/>
    <Label text="1. Solicite la reserva. 2. Confírmela con su código en menos de 10 minutos."
           styleClass="ayuda" wrapText="true"/>
    <GridPane hgap="10" vgap="10">
        <Label text="Evento" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="campoEventoId" promptText="ej.: concierto"
                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="Estudiante" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="campoEstudianteId" promptText="Código del estudiante"
                   GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Button text="Solicitar reserva" onAction="#alSolicitar"
                GridPane.rowIndex="2" GridPane.columnIndex="1"/>
    </GridPane>
    <Separator/>
    <GridPane hgap="10" vgap="10">
        <Label text="Código de la reserva" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="campoCodigo" promptText="Se llena al solicitar; es el contenido del QR"
                   prefColumnCount="30" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Button text="Confirmar reserva" onAction="#alConfirmar"
                GridPane.rowIndex="1" GridPane.columnIndex="1"/>
    </GridPane>
    <Label fx:id="etiquetaMensaje" styleClass="mensaje" wrapText="true"/>
</VBox>
