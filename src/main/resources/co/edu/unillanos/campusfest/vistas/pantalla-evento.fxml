<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- CU3 · Editar evento. Sin fx:controller: App asigna PantallaEventoController. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      styleClass="pantalla" spacing="14">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>
    <Label text="Editar evento" styleClass="titulo"/>
    <Label text="Cargue el evento, cambie sus datos y guarde. El aforo no puede quedar por debajo de los cupos ocupados."
           styleClass="ayuda" wrapText="true"/>
    <HBox spacing="10">
        <TextField fx:id="campoEventoId" promptText="Identificador del evento (ej.: concierto)"
                   onAction="#alCargar" HBox.hgrow="ALWAYS"/>
        <Button text="Cargar" onAction="#alCargar"/>
    </HBox>
    <GridPane hgap="10" vgap="10">
        <Label text="Nombre" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="campoNombre" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="Fecha" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="campoFecha" promptText="aaaa-mm-dd hh:mm"
                   GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="Lugar" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="campoLugar" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <Label text="Aforo" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="campoAforo" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
        <Button text="Guardar cambios" onAction="#alGuardar"
                GridPane.rowIndex="4" GridPane.columnIndex="1"/>
    </GridPane>
    <Label fx:id="etiquetaMensaje" styleClass="mensaje" wrapText="true"/>
</VBox>
