<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- CU1 · Consultar cupos. Sin fx:controller: App asigna PantallaCuposController. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      styleClass="pantalla" spacing="14">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>
    <Label text="Consultar cupos" styleClass="titulo"/>
    <Label text="Escriba el identificador del evento para ver cuántos cupos quedan libres."
           styleClass="ayuda" wrapText="true"/>
    <HBox spacing="10">
        <TextField fx:id="campoEventoId" promptText="Identificador del evento (ej.: concierto)"
                   onAction="#alConsultar" HBox.hgrow="ALWAYS"/>
        <Button text="Consultar" onAction="#alConsultar" defaultButton="true"/>
    </HBox>
    <Label fx:id="etiquetaMensaje" styleClass="mensaje" wrapText="true"/>
</VBox>
